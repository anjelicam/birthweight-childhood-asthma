#| label: load packages
#| code-summary: "Packages"
# Packages Used
pacman::p_load(
dplyr,          # data manipulation
forcats,        # tools for working with categorical variables
here,           # file paths relative to R project root folder
rio,            # import/export of many types of data
tidyverse,      # includes many packages for tidy data wrangling
Hmisc,          # includes many functions in Harrellverse
data.table,     # (alternative) faster than tidyverse
qreport,        # useful for formatting in quarto
sparkline,      # inline interactive plots
lubridate,      # simplifies working with dates
janitor,        # tables and data cleaning
skimr,          # summary statistics
gtsummary,      # making descriptive and statistical tables
rstatix,        # quickly run statistical tests and summaries
labelled,       # labels variables
naniar,         # assessing missing data
datadictionary, # creates data dictionaries
haven,          # read/handle labelled data (e.g. SPSS/Stata/SAS files)
marginaleffects, # predictions, comparisons, and hypothesis tests
modelsummary,
broom,
stringr,
gt,
tibble
)
#| label: setup
#| code-summary: "Setup"
# Source: Frank Harrell https://hbiostat.org/rflow/
# Make base graphics look better:
spar <- function(bot=0, left=0, top=0, rt=0)
par(mar=c(3.25 + bot, 5 + left, 0.5 + top, 0.5 * rt),
lwd=1.75, mgp=c(2.0, 0.475, 0), tcl=-0.4, xpd=FALSE, ps=14,
cex.lab=1.15, cex.axis=0.8)
# Set abbreviations for chunk option names
knitr::set_alias(w = 'fig.width', h = 'fig.height')
options(prType='html')   # for certain Hmisc and rms functions
# To automatically sense which output format is being created and
# create a character string that will work for both `html` and `LaTeX`.
# For `LaTeX`, a boxed note in the body of the document will appear.
ishtml <- knitr::is_html_output()
mNote  <- if(ishtml) '.column-margin' else '.callout-note appearance="minimal"'
#FHarrell: "Note that to initialize javascript jQuery dependencies
# we must include sparkline::sparkline(0) somewhere in the report
# before creating the first sparkline output."
sparkline::sparkline(0)
#| label: load data
#| code-summary: "Load Data"
# Import data
df <- import(here("data", "processed", "nsch2023_processed.rdata"))
# Review data structure
head(df)
# View a data dictionary of df (variable types, levels, and labels)
contents(df)
#| label: descriptives table
#| message: false
#| warning: false
#| code-summary: Table 1
# Creates a descriptive statistics table
tbl_summary(
df,
include = c(age, age_cats, sex, race, hispanic, born_early, poverty,
education, insurance_type, asthma, cigarettes, vape, allergies),
type = all_continuous() ~ "continuous2",
statistic = all_continuous() ~ c("{mean} ({sd})",
"{median} ({p25}-{p75})",
"{min}-{max}"),
percent = "column",
by = birth_weight_low,
missing = "always",
missing_text = "Missing",
missing_stat = "{N_miss} ({p_miss}%)"
) |>
add_overall() |>
add_n() |>
modify_header(label = "**Participant Characteristics**") |>
modify_caption("**Table 1: Characteristics by low birth weight Status**") |>
modify_spanning_header(c("stat_1", "stat_2") ~ "**Low Birth Weight**") |>
add_variable_group_header(
header = "Environmental Exposures",
variables = c(cigarettes, vape, allergies)
) |>
modify_bold(
columns = label,
rows = (row_type == "label" & !variable %in% c("cigarettes", "vape", "allergies")) |
label == "Environmental Exposures"
)
